<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="$(MSBuildThisFileDirectory)Local.props" Condition="Exists('$(MSBuildThisFileDirectory)Local.props')" />

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <NoWarn>CS8632;CS8765</NoWarn>
    <RootNamespace>Stellar.MultiTool</RootNamespace>
    <AssemblyName>Stellar.MultiTool</AssemblyName>
    <Version>1.0.0</Version>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Stellar.Abstractions"       Version="2.26.0" />
    <PackageReference Include="Stellar.PluginContracts"    Version="2.26.0" />
    <PackageReference Include="Stellar.Plugin.InteropRefs" Version="2.26.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources/multitool-icon.png" LogicalName="Stellar.MultiTool.multitool-icon.png" />
    <EmbeddedResource Include="Resources/howto-autoaccept.png" LogicalName="Stellar.MultiTool.howto-autoaccept.png" />
    <EmbeddedResource Include="Resources/icon-bandmute.png" LogicalName="Stellar.MultiTool.icon-bandmute.png" />
    <EmbeddedResource Include="Resources/icon-autoaccept.png" LogicalName="Stellar.MultiTool.icon-autoaccept.png" />
    <EmbeddedResource Include="Resources/banner.png" LogicalName="Stellar.MultiTool.banner.png" />
    <EmbeddedResource Include="Resources/icon-language.png" LogicalName="Stellar.MultiTool.icon-language.png" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="resources/**" />
  </ItemGroup>

</Project>
